  {
   "priority": "Pull first (A)",
   "data_type": "Foreclosure",
   "office_official": "Clerk of the Circuit Court for Carroll County - Sarah Bradberry, Circuit Court Clerk",
   "phone": "410-386-8710",
   "source_url": "http://www.courts.state.md.us/clerks/carroll/records",
   "office_address": "55 N. Court Street, Westminster, MD 21157-5155",
   "records_foia": null,
   "access": "Medium",
   "updates": "Daily",
   "verified": "Verified",
   "notes": "Maryland is an EITHER state - lenders use judicial OR nonjudicial per the recorded instrument. The first public signal is EITHER a court lis pendens / foreclosure complaint OR a recorder-filed notice / trustee sale. Pull BOTH the recorder's trustee-sale filings AND the court foreclosure docket (the lender picks the path in this state; run one cycle of both, keep the one that fills). Civil case information, including foreclosures, is available online through Case Search. Records are available to the public for review."
  },
  {
   "priority": "Pull first (A)",
